# ── Server settings ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All variables must be prefixed with RAG_

# Server bind
RAG_HOST=0.0.0.0
RAG_PORT=8000

# Embedding (runs on GPU server)
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DEVICE=cuda
RAG_EMBEDDING_BATCH_SIZE=32

# Reranker
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_DEVICE=cuda
RAG_RERANKER_ENABLED=false

# Default chunking
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# Default retrieval
RAG_TOP_K=5
RAG_RETRIEVAL_MODE=dense
RAG_HYBRID_ALPHA=0.5

# Ollama (running on same server)
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=qwen2.5:7b
RAG_OLLAMA_JUDGE_MODEL=qwen2.5:7b
RAG_OLLAMA_TIMEOUT=120

# Generation
RAG_MAX_NEW_TOKENS=512
RAG_TEMPERATURE=0.1
